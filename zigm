#!/bin/sh
#
# zigm: a Zig toolchain manager.
#
# Fetches matched zig and zls versions and exposes one of them on PATH via a
# single `current` symlink. See README for the PATH setup you must do yourself.
#
# Portability: POSIX sh only, no bashisms.
#
# Testing: the script does nothing when sourced with ZIGM_LIB=1, so a test
# harness can source it and call individual functions. Detection functions are
# split in two layers:
#
#   * `find_*` and `normalize_*` print a result and return non-zero on failure,
#     take their inputs as arguments, and touch no globals.
#   * `require_*` wrap those, assign the ZIGM_* globals, and exit on failure.

set -eu

ZIGM_VERSION='0.1.0-dev'

# Exit codes.
ZIGM_EX_ERROR=1
ZIGM_EX_USAGE=2
ZIGM_EX_UNIMPLEMENTED=3

# Verbosity, set by the global flags.
ZIGM_VERBOSE=0
ZIGM_QUIET=0

# Upstream endpoints.
ZIGM_INDEX_URL='https://ziglang.org/download/index.json'
ZIGM_ZLS_URL='https://releases.zigtools.org/v1/zls/select-version'

# How long a cached copy of the zig download index stays fresh, in seconds.
ZIGM_INDEX_TTL=${ZIGM_INDEX_TTL:-3600}

# Set by --refresh, ignores a cached index however fresh it is.
ZIGM_REFRESH=0

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

warn() {
    printf 'zigm: warning: %s\n' "$*" >&2
}

err() {
    printf 'zigm: error: %s\n' "$*" >&2
}

die() {
    err "$*"
    exit "$ZIGM_EX_ERROR"
}

die_usage() {
    err "$*"
    printf "try 'zigm --help'\n" >&2
    exit "$ZIGM_EX_USAGE"
}

info() {
    if [ "$ZIGM_QUIET" -eq 0 ]; then
        printf '%s\n' "$*"
    fi
}

# An aside from a command whose stdout is an answer, printed on stderr so that
# the answer stays parseable.
note() {
    if [ "$ZIGM_QUIET" -eq 0 ]; then
        printf '%s\n' "$*" >&2
    fi
}

debug() {
    if [ "$ZIGM_VERBOSE" -eq 1 ]; then
        printf 'zigm: debug: %s\n' "$*" >&2
    fi
}

not_implemented() {
    err "'$1' is not implemented yet"
    exit "$ZIGM_EX_UNIMPLEMENTED"
}

have() {
    command -v "$1" >/dev/null 2>&1
}

usage() {
    cat <<EOF
zigm $ZIGM_VERSION, a Zig toolchain manager.

usage:
  zigm [global options] <command> [arguments]

commands:
  install <version>    install a zig and zls pair, 'master' for nightly
  use <version>        point 'current' at an installed version
  uninstall <version>  remove an installed version
  list                 list installed versions, starring the active one
  list-remote          list versions available upstream
  which [name]         print the path of an active binary, default 'zig'
  current              print the active version
  update               reinstall 'master' at its newest resolved version
  clean                remove the cache directory

global options:
  -h, --help           print this help and exit
  -V, --version        print the zigm version and exit
  -v, --verbose        print debug output on stderr
  -q, --quiet          print errors and warnings only
      --refresh        refetch the download index even when it is cached

environment:
  ZIGM_DATA_DIR        override the data directory
  ZIGM_CACHE_DIR       override the cache directory
  ZIGM_CONFIG_DIR      override the config directory
  ZIGM_INDEX_TTL       seconds a cached download index stays fresh

exit codes:
  0 success, 1 error, 2 usage error, 3 command not implemented
EOF
}

# ---------------------------------------------------------------------------
# Platform and directories
# ---------------------------------------------------------------------------

# normalize_os <uname -s output>
#
# Prints a short os name. Unknown systems are lowercased and passed through, so
# that the failure surfaces later with the real name in the message.
normalize_os() {
    case "$1" in
        Linux) printf 'linux\n' ;;
        Darwin) printf 'macos\n' ;;
        FreeBSD) printf 'freebsd\n' ;;
        NetBSD) printf 'netbsd\n' ;;
        OpenBSD) printf 'openbsd\n' ;;
        DragonFly) printf 'dragonfly\n' ;;
        *) printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' ;;
    esac
}

# normalize_arch <uname -m output>
#
# Prints a short arch name, passing unknown values through unchanged. Mapping
# to a Zig release target triple is a separate step, done at download time.
normalize_arch() {
    case "$1" in
        x86_64 | amd64) printf 'x86_64\n' ;;
        aarch64 | arm64) printf 'aarch64\n' ;;
        armv7 | armv7l) printf 'armv7a\n' ;;
        i386 | i486 | i586 | i686) printf 'x86\n' ;;
        riscv64) printf 'riscv64\n' ;;
        ppc64le) printf 'powerpc64le\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# base_dir <kind> <os> <home>
#
# Prints the zigm directory for `kind`, one of data, cache, or config. The os
# and home are arguments rather than globals so tests can ask for any platform.
base_dir() {
    base_dir_kind="$1"
    base_dir_os="$2"
    base_dir_home="$3"

    if [ -z "$base_dir_home" ]; then
        return 1
    fi

    if [ "$base_dir_os" = macos ]; then
        case "$base_dir_kind" in
            data | config)
                printf '%s/Library/Application Support/zigm\n' "$base_dir_home"
                ;;
            cache) printf '%s/Library/Caches/zigm\n' "$base_dir_home" ;;
            *) return 1 ;;
        esac
        return 0
    fi

    # Everything else follows the XDG base directory spec.
    case "$base_dir_kind" in
        data) printf '%s/zigm\n' "${XDG_DATA_HOME:-$base_dir_home/.local/share}" ;;
        cache) printf '%s/zigm\n' "${XDG_CACHE_HOME:-$base_dir_home/.cache}" ;;
        config) printf '%s/zigm\n' "${XDG_CONFIG_HOME:-$base_dir_home/.config}" ;;
        *) return 1 ;;
    esac
}

# Sets ZIGM_OS and ZIGM_ARCH.
require_platform() {
    ZIGM_OS=$(normalize_os "$(uname -s)")
    ZIGM_ARCH=$(normalize_arch "$(uname -m)")
    debug "platform: $ZIGM_ARCH-$ZIGM_OS"
}

# Sets the directory globals. Requires ZIGM_OS, and creates nothing.
require_dirs() {
    if [ -z "${ZIGM_DATA_DIR:-}" ]; then
        ZIGM_DATA_DIR=$(base_dir data "$ZIGM_OS" "${HOME:-}") ||
            die 'cannot resolve the data directory, HOME is unset'
    fi
    if [ -z "${ZIGM_CACHE_DIR:-}" ]; then
        ZIGM_CACHE_DIR=$(base_dir cache "$ZIGM_OS" "${HOME:-}") ||
            die 'cannot resolve the cache directory, HOME is unset'
    fi
    if [ -z "${ZIGM_CONFIG_DIR:-}" ]; then
        ZIGM_CONFIG_DIR=$(base_dir config "$ZIGM_OS" "${HOME:-}") ||
            die 'cannot resolve the config directory, HOME is unset'
    fi

    ZIGM_VERSIONS_DIR="$ZIGM_DATA_DIR/versions"
    ZIGM_CURRENT_LINK="$ZIGM_DATA_DIR/current"

    debug "data dir: $ZIGM_DATA_DIR"
    debug "cache dir: $ZIGM_CACHE_DIR"
    debug "config dir: $ZIGM_CONFIG_DIR"
    debug "current link: $ZIGM_CURRENT_LINK"
}

# Creates the directories zigm writes to. Requires require_dirs.
ensure_dirs() {
    mkdir -p "$ZIGM_VERSIONS_DIR" || die "cannot create $ZIGM_VERSIONS_DIR"
    mkdir -p "$ZIGM_CACHE_DIR" || die "cannot create $ZIGM_CACHE_DIR"
}

# ---------------------------------------------------------------------------
# Tool detection
# ---------------------------------------------------------------------------

# Prints the name of an available downloader, curl preferred.
find_downloader() {
    if have curl; then
        printf 'curl\n'
    elif have wget; then
        printf 'wget\n'
    else
        return 1
    fi
}

# Prints how to decompress xz, either 'xz' for a separate binary or 'tar' when
# tar handles it alone. A separate xz is preferred since it is unambiguous.
find_xz() {
    if have xz; then
        printf 'xz\n'
    elif have tar && tar --help 2>&1 | grep -qi -e '-J' -e 'xz'; then
        printf 'tar\n'
    else
        return 1
    fi
}

# Prints the name of an available sha256 tool.
find_sha256() {
    if have sha256sum; then
        printf 'sha256sum\n'
    elif have shasum; then
        printf 'shasum\n'
    elif have openssl; then
        printf 'openssl\n'
    elif have cksum && cksum -a sha256 </dev/null >/dev/null 2>&1; then
        printf 'cksum\n'
    else
        return 1
    fi
}

# Sets ZIGM_DOWNLOADER.
require_downloader() {
    ZIGM_DOWNLOADER=$(find_downloader) ||
        die 'no downloader found, install curl or wget'
    debug "downloader: $ZIGM_DOWNLOADER"
}

# Sets ZIGM_XZ.
require_extractor() {
    have tar || die 'no tar found, install tar'
    ZIGM_XZ=$(find_xz) ||
        die 'no xz support found, install xz or a tar built with xz support'
    debug "xz via: $ZIGM_XZ"
}

require_jq() {
    have jq || die 'no jq found, install jq'
}

# Sets ZIGM_SHA256, empty when nothing is available. Missing checksum tools are
# a loud warning rather than an error, by design.
require_sha256() {
    if ZIGM_SHA256=$(find_sha256); then
        debug "sha256 via: $ZIGM_SHA256"
    else
        ZIGM_SHA256=''
        warn 'no sha256 tool found, downloads will not be verified'
        warn 'install one of sha256sum, shasum, openssl, or a cksum with -a'
    fi
}

# ---------------------------------------------------------------------------
# Download
# ---------------------------------------------------------------------------

# fetch_stdout <url>
#
# Writes the response body to stdout. Requires require_downloader.
fetch_stdout() {
    debug "fetch: $1"
    case "$ZIGM_DOWNLOADER" in
        curl) curl -fsSL -- "$1" ;;
        wget) wget -qO- -- "$1" ;;
        *) die "unknown downloader '$ZIGM_DOWNLOADER'" ;;
    esac
}

# fetch_file <url> <destination>
#
# Downloads to destination. Requires require_downloader.
fetch_file() {
    debug "fetch: $1 -> $2"
    case "$ZIGM_DOWNLOADER" in
        curl) curl -fsSL -o "$2" -- "$1" ;;
        wget) wget -qO "$2" -- "$1" ;;
        *) die "unknown downloader '$ZIGM_DOWNLOADER'" ;;
    esac
}

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# Prints the time in seconds since the epoch, and fails when `date` cannot
# produce it. A system that cannot is not an error, it only loses caching.
find_epoch() {
    find_epoch_now=$(date +%s 2>/dev/null) || return 1
    case "$find_epoch_now" in
        '' | *[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$find_epoch_now"
}

# cache_fresh <path> <ttl seconds> <now>
#
# True when the file and its stamp both exist and the stamp is less than the
# ttl old. A stamp in the future counts as stale, so a clock that jumped
# backwards cannot pin a stale file in place.
cache_fresh() {
    [ -f "$1" ] && [ -f "$1.stamp" ] || return 1

    cache_fresh_at=$(cat "$1.stamp" 2>/dev/null) || return 1
    case "$cache_fresh_at" in
        '' | *[!0-9]*) return 1 ;;
    esac
    case "$3" in
        '' | *[!0-9]*) return 1 ;;
    esac

    [ "$3" -ge "$cache_fresh_at" ] || return 1
    [ "$(($3 - cache_fresh_at))" -lt "$2" ]
}

# fetch_cached <url> <path> <ttl seconds>
#
# Downloads the url to the path unless a fresh copy is already there. The time
# of the download is recorded in a stamp file beside it. Both --refresh and a
# system without a usable `date` force the download.
fetch_cached() {
    fetch_cached_now=$(find_epoch) || fetch_cached_now=''

    if [ "$ZIGM_REFRESH" -eq 0 ] && [ -n "$fetch_cached_now" ] &&
        cache_fresh "$2" "$3" "$fetch_cached_now"; then
        debug "cached: $2"
        return 0
    fi

    fetch_cached_dir=$(dirname -- "$2")
    mkdir -p "$fetch_cached_dir" || die "cannot create $fetch_cached_dir"

    # Download beside the target and move it into place, so an interrupted
    # download cannot leave a truncated file looking like a good one.
    fetch_file "$1" "$2.part" || die "cannot download $1"
    mv -f "$2.part" "$2" || die "cannot write $2"

    if [ -n "$fetch_cached_now" ]; then
        printf '%s\n' "$fetch_cached_now" >"$2.stamp"
    else
        rm -f "$2.stamp"
    fi
}

# ---------------------------------------------------------------------------
# Version resolution
#
# The zig download index and the zls version API both key their per platform
# builds by `<arch>-<os>`, but the spelling of two arches changed over time:
# zig used `armv7a` up to 0.14.1 and `arm` from 0.15.1, and `i386` up to 0.10.1
# and `x86` from 0.11.0, while zls uses `armv7a` and `x86` throughout. Lookups
# therefore try a short list of candidate keys rather than one fixed key.
# ---------------------------------------------------------------------------

# target_candidates <arch> <os>
#
# Prints the keys that could name a build for this platform, best first.
target_candidates() {
    case "$1" in
        arm | armv7a) printf 'arm-%s\narmv7a-%s\n' "$2" "$2" ;;
        x86 | i386) printf 'x86-%s\ni386-%s\n' "$2" "$2" ;;
        *) printf '%s-%s\n' "$1" "$2" ;;
    esac
}

# find_target <json object> <arch> <os>
#
# Prints the first candidate key the object actually carries.
find_target() {
    for find_target_key in $(target_candidates "$2" "$3"); do
        if printf '%s\n' "$1" |
            jq -e --arg k "$find_target_key" 'has($k)' >/dev/null 2>&1; then
            printf '%s\n' "$find_target_key"
            return 0
        fi
    done
    return 1
}

# find_target_field <json object> <target key> <field>
#
# Prints one field of a per platform build, `tarball` or `shasum`.
find_target_field() {
    printf '%s\n' "$1" |
        jq -e -r --arg k "$2" --arg f "$3" '.[$k][$f] // empty' 2>/dev/null
}

# find_release <index file> <version>
#
# Prints the index entry for a version, `master` included, as compact json.
find_release() {
    jq -e -c --arg v "$2" '.[$v] // empty' "$1" 2>/dev/null
}

# find_release_version <release json> <requested version>
#
# Prints the concrete version of a release. `master` always carries one, and
# tagged releases before 0.15.1 do not, but there the request is already
# concrete. A `master` entry without one is an upstream change worth failing on
# rather than storing a nightly under the name `master`.
find_release_version() {
    find_release_version_v=$(printf '%s\n' "$1" |
        jq -e -r '.version // empty' 2>/dev/null) || find_release_version_v=''

    if [ -n "$find_release_version_v" ]; then
        printf '%s\n' "$find_release_version_v"
    elif [ "$2" = master ]; then
        return 1
    else
        printf '%s\n' "$2"
    fi
}

# normalize_query <value>
#
# Percent encodes a query string value. Of the characters a zig version can
# hold, only `+` needs it, since a server is free to read that as a space.
normalize_query() {
    printf '%s\n' "$1" | sed 's/+/%2B/g'
}

# zls_url <zig version>
#
# Prints the version selection API url for a zig version. `only-runtime` asks
# for a zls that runs against that zig, rather than one built by it.
zls_url() {
    printf '%s?zig_version=%s&compatibility=only-runtime\n' \
        "$ZIGM_ZLS_URL" "$(normalize_query "$1")"
}

# Sets ZIGM_INDEX_FILE, downloading the index when the cached copy is stale.
require_index() {
    ZIGM_INDEX_FILE="$ZIGM_CACHE_DIR/index.json"
    fetch_cached "$ZIGM_INDEX_URL" "$ZIGM_INDEX_FILE" "$ZIGM_INDEX_TTL"
}

# require_zig <version>
#
# Sets ZIGM_ZIG_VERSION, ZIGM_ZIG_TARGET, ZIGM_ZIG_TARBALL, and
# ZIGM_ZIG_SHASUM. The version may be `master`, which resolves to the concrete
# dev version the index names today. Requires require_platform.
require_zig() {
    require_index

    require_zig_json=$(find_release "$ZIGM_INDEX_FILE" "$1") ||
        die "no zig '$1' in the download index"

    ZIGM_ZIG_VERSION=$(find_release_version "$require_zig_json" "$1") ||
        die "the download index entry for '$1' carries no version"

    ZIGM_ZIG_TARGET=$(find_target "$require_zig_json" "$ZIGM_ARCH" "$ZIGM_OS") ||
        die "zig $ZIGM_ZIG_VERSION has no build for $ZIGM_ARCH-$ZIGM_OS"

    ZIGM_ZIG_TARBALL=$(find_target_field "$require_zig_json" \
        "$ZIGM_ZIG_TARGET" tarball) ||
        die "zig $ZIGM_ZIG_VERSION has no tarball for $ZIGM_ZIG_TARGET"

    # An entry without one is rare but real, and checksum verification is a
    # warning rather than an error, so an empty shasum is not fatal here.
    # shellcheck disable=SC2034 # read by install, which is not written yet.
    ZIGM_ZIG_SHASUM=$(find_target_field "$require_zig_json" \
        "$ZIGM_ZIG_TARGET" shasum) || ZIGM_ZIG_SHASUM=''

    debug "zig $ZIGM_ZIG_VERSION ($ZIGM_ZIG_TARGET): $ZIGM_ZIG_TARBALL"
}

# require_zls <zig version>
#
# Sets ZIGM_ZLS_VERSION, ZIGM_ZLS_TARGET, ZIGM_ZLS_TARBALL, and
# ZIGM_ZLS_SHASUM. The API pairs zig and zls for tagged and master builds
# alike, so a concrete zig version is the only input it needs. The response is
# not cached, since a pairing is cheap to fetch and expensive to get wrong.
# Requires require_platform and require_downloader.
require_zls() {
    require_zls_json=$(fetch_stdout "$(zls_url "$1")") ||
        die "cannot reach the zls version API"

    # The API reports a missing or unreleased pairing as a json error object
    # rather than as an http status.
    require_zls_msg=$(printf '%s\n' "$require_zls_json" |
        jq -e -r '.message // empty' 2>/dev/null) || require_zls_msg=''
    [ -z "$require_zls_msg" ] || die "no zls for zig $1: $require_zls_msg"

    ZIGM_ZLS_VERSION=$(printf '%s\n' "$require_zls_json" |
        jq -e -r '.version // empty' 2>/dev/null) ||
        die "the zls version API named no version for zig $1"

    ZIGM_ZLS_TARGET=$(find_target "$require_zls_json" "$ZIGM_ARCH" "$ZIGM_OS") ||
        die "zls $ZIGM_ZLS_VERSION has no build for $ZIGM_ARCH-$ZIGM_OS"

    ZIGM_ZLS_TARBALL=$(find_target_field "$require_zls_json" \
        "$ZIGM_ZLS_TARGET" tarball) ||
        die "zls $ZIGM_ZLS_VERSION has no tarball for $ZIGM_ZLS_TARGET"

    # shellcheck disable=SC2034 # read by install, which is not written yet.
    ZIGM_ZLS_SHASUM=$(find_target_field "$require_zls_json" \
        "$ZIGM_ZLS_TARGET" shasum) || ZIGM_ZLS_SHASUM=''

    debug "zls $ZIGM_ZLS_VERSION ($ZIGM_ZLS_TARGET): $ZIGM_ZLS_TARBALL"
}

# ---------------------------------------------------------------------------
# Installed versions
#
# A version lives in `<data>/zigm/versions/<version>/`, which holds the zig and
# zls binaries next to zig's `lib` directory, since zig finds that directory
# relative to its own path. The active version is named by the `current`
# symlink beside `versions`, which is what the user puts on PATH.
# ---------------------------------------------------------------------------

# is_version_name <name>
#
# True when a name can name a directory under the versions directory. Anything
# holding a slash, or starting with a dot, could reach outside it or collide
# with the dot prefixed scratch directories an install writes.
is_version_name() {
    case "$1" in
        '' | .* | */*) return 1 ;;
    esac
}

# find_versions <versions dir>
#
# Prints the installed versions, one per line, in whatever order the directory
# gives. Dot prefixed entries are skipped, so a half finished install is not
# reported as a version.
find_versions() {
    [ -d "$1" ] || return 1

    for find_versions_path in "$1"/*; do
        [ -d "$find_versions_path" ] || continue
        printf '%s\n' "${find_versions_path##*/}"
    done
}

# sort_versions
#
# Reads versions on stdin and prints them oldest first. The key is the three
# numeric components, then a marker placing a `-dev` build before the release
# it leads up to, then the dev counter. Padding every number to a fixed width
# keeps the comparison a plain string sort.
sort_versions() {
    awk -F'[.]' '{
        patch = $3
        sub(/-.*$/, "", patch)
        if ($0 ~ /-dev[.]/) { tag = 0; counter = $4 + 0 }
        else { tag = 1; counter = 0 }
        printf "%08d.%08d.%08d.%d.%08d\t%s\n", $1, $2, patch, tag, counter, $0
    }' | LC_ALL=C sort | cut -f2
}

# find_link_version <link path>
#
# Prints the version a `current` style symlink points at, and fails when the
# link is missing or dangling. `cd -P` resolves it without `readlink`, which is
# not in every base system.
find_link_version() {
    [ -L "$1" ] || return 1

    find_link_version_dir=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) ||
        return 1

    # The last component of the resolved path is the version, since that is
    # how installs are named. Stripping it here keeps `basename` out of the
    # way, whose handling of a leading `--` is not the same everywhere.
    find_link_version_dir="${find_link_version_dir##*/}"
    [ -n "$find_link_version_dir" ] || return 1

    printf '%s\n' "$find_link_version_dir"
}

# swap_link <target dir> <link path>
#
# Points the link at the target, replacing whatever is there already.
#
# `mv` onto a symlink to a directory moves the source inside that directory
# unless it is told not to, and the option saying so is spelled `-T` by GNU and
# `-h` by BSD, so both are tried before falling back to an unlink and a rename.
# The fallback is not atomic, but its window is one syscall wide and it leaves
# the link missing rather than wrong.
swap_link() {
    swap_link_target=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) ||
        return 1

    swap_link_tmp="$2.new"
    rm -f -- "$swap_link_tmp" || return 1
    ln -s -- "$1" "$swap_link_tmp" || return 1

    mv -T -- "$swap_link_tmp" "$2" 2>/dev/null ||
        mv -h -- "$swap_link_tmp" "$2" 2>/dev/null ||
        { rm -f -- "$2" && mv -f -- "$swap_link_tmp" "$2"; } || return 1

    # An `mv` that took neither option would have moved the new link inside the
    # old target instead of replacing it, so confirm where the link points now.
    swap_link_now=$(CDPATH='' cd -P -- "$2" 2>/dev/null && pwd -P) || return 1
    [ "$swap_link_now" = "$swap_link_target" ]
}

# ---------------------------------------------------------------------------
# Commands
#
# Each command declares the tools it needs, so a missing dependency fails
# before any work happens.
# ---------------------------------------------------------------------------

cmd_install() {
    [ "$#" -eq 1 ] || die_usage 'install takes exactly one version'
    require_downloader
    require_extractor
    require_jq
    require_sha256
    ensure_dirs
    require_zig "$1"
    require_zls "$ZIGM_ZIG_VERSION"
    info "resolved zig $ZIGM_ZIG_VERSION with zls $ZIGM_ZLS_VERSION"
    not_implemented install
}

cmd_use() {
    [ "$#" -eq 1 ] || die_usage 'use takes exactly one version'
    is_version_name "$1" || die_usage "'$1' is not a version"
    ensure_dirs

    cmd_use_dir="$ZIGM_VERSIONS_DIR/$1"
    if [ ! -d "$cmd_use_dir" ]; then
        # master is stored under the dev version it resolved to, so it never
        # names a directory of its own.
        [ "$1" != master ] ||
            die "master is installed under its resolved version, see 'zigm list'"
        die "zig $1 is not installed, run 'zigm install $1'"
    fi

    swap_link "$cmd_use_dir" "$ZIGM_CURRENT_LINK" ||
        die "cannot point $ZIGM_CURRENT_LINK at $cmd_use_dir"

    info "now using zig $1"
}

cmd_uninstall() {
    [ "$#" -eq 1 ] || die_usage 'uninstall takes exactly one version'
    is_version_name "$1" || die_usage "'$1' is not a version"

    cmd_uninstall_dir="$ZIGM_VERSIONS_DIR/$1"
    [ -d "$cmd_uninstall_dir" ] || die "zig $1 is not installed"

    # Drop the link first, so an interrupted removal cannot leave `current`
    # pointing into a half deleted directory.
    if [ "$(find_link_version "$ZIGM_CURRENT_LINK")" = "$1" ]; then
        rm -f -- "$ZIGM_CURRENT_LINK" ||
            die "cannot remove $ZIGM_CURRENT_LINK"
        warn "zig $1 was active, no version is active now"
    fi

    rm -rf -- "$cmd_uninstall_dir" || die "cannot remove $cmd_uninstall_dir"
    info "removed zig $1"
}

cmd_list() {
    [ "$#" -eq 0 ] || die_usage 'list takes no arguments'

    cmd_list_active=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        cmd_list_active=''
    cmd_list_all=$(find_versions "$ZIGM_VERSIONS_DIR" | sort_versions)

    if [ -z "$cmd_list_all" ]; then
        note 'no versions installed'
        return 0
    fi

    # The active version is marked with a star, so a caller that wants bare
    # names can cut the first two columns.
    printf '%s\n' "$cmd_list_all" | while IFS= read -r cmd_list_version; do
        if [ "$cmd_list_version" = "$cmd_list_active" ]; then
            printf '* %s\n' "$cmd_list_version"
        else
            printf '  %s\n' "$cmd_list_version"
        fi
    done
}

cmd_list_remote() {
    [ "$#" -eq 0 ] || die_usage 'list-remote takes no arguments'
    require_downloader
    require_jq
    not_implemented list-remote
}

cmd_which() {
    [ "$#" -le 1 ] || die_usage 'which takes at most one binary name'
    cmd_which_name=${1:-zig}
    case "$cmd_which_name" in
        '' | */*) die_usage "'$cmd_which_name' is not a binary name" ;;
    esac

    cmd_which_version=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        die "no version is active, run 'zigm use <version>'"

    # The resolved path is printed rather than the one through `current`, since
    # it names the version the binary belongs to.
    cmd_which_path="$ZIGM_VERSIONS_DIR/$cmd_which_version/$cmd_which_name"
    [ -x "$cmd_which_path" ] ||
        die "zig $cmd_which_version has no '$cmd_which_name'"

    printf '%s\n' "$cmd_which_path"
}

cmd_current() {
    [ "$#" -eq 0 ] || die_usage 'current takes no arguments'

    cmd_current_version=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        die "no version is active, run 'zigm use <version>'"

    printf '%s\n' "$cmd_current_version"
}

cmd_update() {
    [ "$#" -eq 0 ] || die_usage 'update takes no arguments'
    require_downloader
    require_extractor
    require_jq
    require_sha256
    ensure_dirs
    # update is install of whatever master points at today, so it always
    # refetches the index rather than trusting a cached one.
    ZIGM_REFRESH=1
    require_zig master
    require_zls "$ZIGM_ZIG_VERSION"
    info "resolved zig $ZIGM_ZIG_VERSION with zls $ZIGM_ZLS_VERSION"
    not_implemented update
}

cmd_clean() {
    [ "$#" -eq 0 ] || die_usage 'clean takes no arguments'

    # The cache holds only the download index and the tarballs, both of which
    # are refetched on demand, so the whole directory goes.
    [ -n "$ZIGM_CACHE_DIR" ] || die 'the cache directory is empty'
    if [ ! -d "$ZIGM_CACHE_DIR" ]; then
        note 'the cache is already empty'
        return 0
    fi

    rm -rf -- "$ZIGM_CACHE_DIR" || die "cannot remove $ZIGM_CACHE_DIR"
    info "removed $ZIGM_CACHE_DIR"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -h | --help)
                usage
                return 0
                ;;
            -V | --version)
                printf '%s\n' "$ZIGM_VERSION"
                return 0
                ;;
            -v | --verbose)
                ZIGM_VERBOSE=1
                shift
                ;;
            -q | --quiet)
                ZIGM_QUIET=1
                shift
                ;;
            --refresh)
                ZIGM_REFRESH=1
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                die_usage "unknown option '$1'"
                ;;
            *)
                break
                ;;
        esac
    done

    if [ "$#" -eq 0 ]; then
        usage >&2
        return "$ZIGM_EX_USAGE"
    fi

    main_cmd="$1"
    shift

    require_platform
    require_dirs

    case "$main_cmd" in
        install) cmd_install "$@" ;;
        use) cmd_use "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        list) cmd_list "$@" ;;
        list-remote) cmd_list_remote "$@" ;;
        which) cmd_which "$@" ;;
        current) cmd_current "$@" ;;
        update) cmd_update "$@" ;;
        clean) cmd_clean "$@" ;;
        *) die_usage "unknown command '$main_cmd'" ;;
    esac
}

if [ "${ZIGM_LIB:-0}" != 1 ]; then
    main "$@"
fi
