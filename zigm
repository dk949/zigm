#!/bin/sh
#
# zigm: a Zig toolchain manager.
#
# Fetches matched zig and zls versions and exposes one of them on PATH via a
# single `current` symlink. See README for the PATH setup you must do yourself.
#
# Portability: POSIX sh only, no bashisms.
#
# Testing: the script does nothing when sourced with ZIGM_LIB=1, so a test
# harness can source it and call individual functions. Detection functions are
# split in two layers:
#
#   * `find_*` and `normalize_*` print a result and return non-zero on failure,
#     take their inputs as arguments, and touch no globals.
#   * `require_*` wrap those, assign the ZIGM_* globals, and exit on failure.

set -eu

ZIGM_VERSION='0.1.0-dev'

# Exit codes.
ZIGM_EX_ERROR=1
ZIGM_EX_USAGE=2

# Verbosity, set by the global flags.
ZIGM_VERBOSE=0
ZIGM_QUIET=0

# Upstream endpoints.
ZIGM_INDEX_URL='https://ziglang.org/download/index.json'
ZIGM_ZLS_URL='https://releases.zigtools.org/v1/zls/select-version'

# How long a cached copy of the zig download index stays fresh, in seconds.
ZIGM_INDEX_TTL=${ZIGM_INDEX_TTL:-3600}

# Set by --refresh, ignores a cached index however fresh it is.
ZIGM_REFRESH=0

# The lock this run holds, and the version whose scratch it is assembling, both
# read by the exit handler and empty while there is nothing to give back.
ZIGM_LOCK_DIR=''
ZIGM_SCRATCH_VERSION=''

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

warn() {
    printf 'zigm: warning: %s\n' "$*" >&2
}

err() {
    printf 'zigm: error: %s\n' "$*" >&2
}

die() {
    err "$*"
    exit "$ZIGM_EX_ERROR"
}

die_usage() {
    err "$*"
    printf "try 'zigm --help'\n" >&2
    exit "$ZIGM_EX_USAGE"
}

info() {
    if [ "$ZIGM_QUIET" -eq 0 ]; then
        printf '%s\n' "$*"
    fi
}

# An aside from a command whose stdout is an answer, printed on stderr so that
# the answer stays parseable.
note() {
    if [ "$ZIGM_QUIET" -eq 0 ]; then
        printf '%s\n' "$*" >&2
    fi
}

debug() {
    if [ "$ZIGM_VERBOSE" -eq 1 ]; then
        printf 'zigm: debug: %s\n' "$*" >&2
    fi
}

have() {
    command -v "$1" >/dev/null 2>&1
}

usage() {
    cat <<EOF
zigm $ZIGM_VERSION, a Zig toolchain manager.

usage:
  zigm [global options] <command> [arguments]

The global options are accepted after the command as well as before it, and
'zigm <command> --help' describes one command on its own.

commands:
  install <version>    install a zig and zls pair, 'master' for nightly
  use <version>        point 'current' at an installed version
  uninstall <version>  remove an installed version
  list                 list installed versions and the zls each one holds
  list-remote          list upstream versions, 'i' marks an installed one
  which [name]         print the path of an active binary, default 'zig'
  current              print the active version and the zls it holds
  env                  print the active zig's 'zig env' as json
  update               install 'master' at its newest resolved version
  clean                remove the cache and any unfinished install leftovers

install and update options:
      --no-zls         install zig alone rather than failing when no zls pairs
      --no-use         leave 'current' alone, install only ('install' only)
      --force          reinstall a version that is already installed

global options:
  -h, --help           print this help and exit
  -V, --version        print the zigm version and exit
  -v, --verbose        print debug output on stderr
  -q, --quiet          print errors and warnings only
      --refresh        refetch the download index even when it is cached

environment:
  ZIGM_DATA_DIR        override the data directory
  ZIGM_CACHE_DIR       override the cache directory
  ZIGM_CONFIG_DIR      override the config directory
  ZIGM_INDEX_TTL       seconds a cached download index stays fresh

exit codes:
  0 success, 1 error, 2 usage error
EOF
}

# usage_command <command>
#
# Prints the help for one command, and fails on a name that is not a command,
# leaving the caller to report it. The global options are described by `usage`
# alone, since they read the same whichever command they are given to.
usage_command() {
    case "$1" in
        install)
            cat <<'EOF'
usage: zigm install [options] <version>

Installs a matched zig and zls pair and points 'current' at it. The version is
a tagged release, or 'master' for the nightly, which is stored under the
version it resolves to.

options:
      --no-zls   install zig alone rather than failing when no zls pairs
      --no-use   leave 'current' alone, install only
      --force    reinstall a version that is already installed

A version that is already installed is left as it is, except that one holding
no zls gains the zls it pairs with, which is how an install made with
'--no-zls' fills that in later.
EOF
            ;;
        use)
            cat <<'EOF'
usage: zigm use <version>

Points 'current' at an installed version, in one symlink swap. The version is
the one 'zigm list' names, so a nightly is asked for by the version it was
installed under rather than by 'master'.
EOF
            ;;
        uninstall)
            cat <<'EOF'
usage: zigm uninstall <version>

Removes an installed version. Removing the active one drops the 'current' link
first, leaving no version active.
EOF
            ;;
        list)
            cat <<'EOF'
usage: zigm list

Lists the installed versions, oldest first, with a star on the active one and
the zls each one holds in a column of its own. A version installed with
'--no-zls' says 'no zls', and one installed before zigm kept a record says
'zls (unknown)'.
EOF
            ;;
        list-remote)
            cat <<'EOF'
usage: zigm list-remote

Lists the upstream versions that have a build for this platform, oldest first,
with a star on the active one and an 'i' on one that is installed. The nightly
is listed under the version it resolves to today, annotated with '(master)'.
EOF
            ;;
        which)
            cat <<'EOF'
usage: zigm which [name]

Prints the path of a binary in the active version, 'zig' by default. The path
names the version directory rather than the 'current' link, so it says which
version the binary belongs to.
EOF
            ;;
        current)
            cat <<'EOF'
usage: zigm current

Prints the active version and the zls it holds, in the columns 'list' uses,
and fails when no version is active.
EOF
            ;;
        env)
            cat <<'EOF'
usage: zigm env

Runs the active zig's 'zig env' and prints what it says as json. Zig moved
that output from json to zon in 0.15, so zon is converted and json is passed
through, leaving the shape the same whichever version is active.
EOF
            ;;
        update)
            cat <<'EOF'
usage: zigm update [options]

Installs 'master' at the version it resolves to now, always refetching the
download index. 'current' follows the new nightly only when it pointed at a
nightly already, or when no version was active, so a pinned release stays.

options:
      --no-zls   install zig alone rather than failing when no zls pairs
      --force    reinstall a version that is already installed
EOF
            ;;
        clean)
            cat <<'EOF'
usage: zigm clean

Removes the cache directory, which holds the download index alone and is
refetched on demand, and the directories an install killed partway through
left under 'versions'. Installed versions are left alone, and a reinstall
that never finished puts its old version back.
EOF
            ;;
        *) return 1 ;;
    esac

    printf "\nthe global options are accepted here too, see 'zigm --help'\n"
}

# ---------------------------------------------------------------------------
# Platform and directories
# ---------------------------------------------------------------------------

# normalize_os <uname -s output>
#
# Prints a short os name. Unknown systems are lowercased and passed through, so
# that the failure surfaces later with the real name in the message.
normalize_os() {
    case "$1" in
        Linux) printf 'linux\n' ;;
        Darwin) printf 'macos\n' ;;
        FreeBSD) printf 'freebsd\n' ;;
        NetBSD) printf 'netbsd\n' ;;
        OpenBSD) printf 'openbsd\n' ;;
        DragonFly) printf 'dragonfly\n' ;;
        *) printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' ;;
    esac
}

# normalize_arch <uname -m output>
#
# Prints a short arch name, passing unknown values through unchanged. Mapping
# to a Zig release target triple is a separate step, done at download time.
normalize_arch() {
    case "$1" in
        x86_64 | amd64) printf 'x86_64\n' ;;
        aarch64 | arm64) printf 'aarch64\n' ;;
        armv7 | armv7l) printf 'armv7a\n' ;;
        i386 | i486 | i586 | i686) printf 'x86\n' ;;
        riscv64) printf 'riscv64\n' ;;
        ppc64le) printf 'powerpc64le\n' ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# parent_dir <path>
#
# Prints the directory holding a path, standing in for `dirname`. Busybox parses
# its own arguments per applet, so a `dirname --` may well read the `--` as the
# path rather than as the end of the options.
parent_dir() {
    case "$1" in
        */*) ;;
        # A path with no slash names something in the working directory.
        *) printf '.\n' && return 0 ;;
    esac

    parent_dir_head="${1%/*}"

    # A path directly under the root strips to nothing.
    printf '%s\n' "${parent_dir_head:-/}"
}

# is_removable <directory>
#
# False when a directory is the root, however it is spelled, and false when it
# cannot be reached at all. `cd -P` settles the spelling, so `/`, `//`, `/.`,
# and a symlink to any of them are all caught.
#
# Every recursive removal zigm makes is of a path it built itself out of a
# checked version name, so this guards only the one directory a user names,
# the cache. It is cheap enough to be worth having anyway.
is_removable() {
    # An empty path is refused here rather than by `cd`, which POSIX leaves
    # unspecified for one and which dash and zsh take as a no-op success.
    [ -n "$1" ] || return 1

    is_removable_real=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) ||
        return 1

    # A path of exactly two leading slashes is the implementation's to define,
    # so `pwd -P` may name the root `//`, as it does under bash.
    case "$is_removable_real" in
        '' | / | //) return 1 ;;
    esac
}

# base_dir <kind> <os> <home>
#
# Prints the zigm directory for `kind`, one of data, cache, or config. The os
# and home are arguments rather than globals so tests can ask for any platform.
base_dir() {
    base_dir_kind="$1"
    base_dir_os="$2"
    base_dir_home="$3"

    if [ -z "$base_dir_home" ]; then
        return 1
    fi

    if [ "$base_dir_os" = macos ]; then
        case "$base_dir_kind" in
            data | config)
                printf '%s/Library/Application Support/zigm\n' "$base_dir_home"
                ;;
            cache) printf '%s/Library/Caches/zigm\n' "$base_dir_home" ;;
            *) return 1 ;;
        esac
        return 0
    fi

    # Everything else follows the XDG base directory spec.
    case "$base_dir_kind" in
        data) printf '%s/zigm\n' "${XDG_DATA_HOME:-$base_dir_home/.local/share}" ;;
        cache) printf '%s/zigm\n' "${XDG_CACHE_HOME:-$base_dir_home/.cache}" ;;
        config) printf '%s/zigm\n' "${XDG_CONFIG_HOME:-$base_dir_home/.config}" ;;
        *) return 1 ;;
    esac
}

# Sets ZIGM_OS and ZIGM_ARCH.
require_platform() {
    ZIGM_OS=$(normalize_os "$(uname -s)")
    ZIGM_ARCH=$(normalize_arch "$(uname -m)")
    debug "platform: $ZIGM_ARCH-$ZIGM_OS"
}

# Sets the directory globals. Requires ZIGM_OS, and creates nothing.
require_dirs() {
    if [ -z "${ZIGM_DATA_DIR:-}" ]; then
        ZIGM_DATA_DIR=$(base_dir data "$ZIGM_OS" "${HOME:-}") ||
            die 'cannot resolve the data directory, HOME is unset'
    fi
    if [ -z "${ZIGM_CACHE_DIR:-}" ]; then
        ZIGM_CACHE_DIR=$(base_dir cache "$ZIGM_OS" "${HOME:-}") ||
            die 'cannot resolve the cache directory, HOME is unset'
    fi
    if [ -z "${ZIGM_CONFIG_DIR:-}" ]; then
        ZIGM_CONFIG_DIR=$(base_dir config "$ZIGM_OS" "${HOME:-}") ||
            die 'cannot resolve the config directory, HOME is unset'
    fi

    ZIGM_VERSIONS_DIR="$ZIGM_DATA_DIR/versions"
    ZIGM_CURRENT_LINK="$ZIGM_DATA_DIR/current"

    debug "data dir: $ZIGM_DATA_DIR"
    debug "cache dir: $ZIGM_CACHE_DIR"
    debug "config dir: $ZIGM_CONFIG_DIR"
    debug "current link: $ZIGM_CURRENT_LINK"
}

# Creates the directories zigm writes to. Requires require_dirs.
ensure_dirs() {
    mkdir -p "$ZIGM_VERSIONS_DIR" || die "cannot create $ZIGM_VERSIONS_DIR"
    mkdir -p "$ZIGM_CACHE_DIR" || die "cannot create $ZIGM_CACHE_DIR"
}

# ---------------------------------------------------------------------------
# Locking
#
# Two runs installing one version share a scratch directory, and a `clean`
# alongside an install sweeps that scratch out from under it, so every command
# that writes takes one lock over the whole data directory first. The commands
# that only read take nothing.
#
# `mkdir` is the only exclusive create POSIX sh has, so the lock is a directory
# holding the pid of the run that took it. A lock whose owner is gone is
# reclaimed, since a kill or a power loss leaves nobody to give it back.
# ---------------------------------------------------------------------------

# find_lock_pid <lock directory>
#
# Prints the pid a lock records, and fails when it records none or records
# something that is not a pid.
find_lock_pid() {
    [ -f "$1/pid" ] || return 1

    find_lock_pid_value=$(cat -- "$1/pid" 2>/dev/null) || return 1
    case "$find_lock_pid_value" in
        '' | *[!0-9]*) return 1 ;;
    esac

    printf '%s\n' "$find_lock_pid_value"
}

# is_stale_lock <lock directory>
#
# True when the run that took the lock is gone.
#
# A lock recording no pid is not stale. It is either a run that has not written
# its pid yet, a window one `printf` wide, or one that died inside that window,
# and the two cannot be told apart, so that rare second case is left to the
# user, whom the message points at the directory.
#
# `kill -0` cannot see a process of another user, but a data directory belongs
# to one user, so a live owner is always one of their own.
is_stale_lock() {
    is_stale_lock_pid=$(find_lock_pid "$1") || return 1

    ! kill -0 "$is_stale_lock_pid" 2>/dev/null
}

# The one EXIT handler, since a shell keeps a single one and both the scratch
# of a running install and the lock have to be given back on the way out. That
# includes the way out an interrupt makes: the signal handlers only exit,
# leaving the work to the handler POSIX runs on the way out of an `exit` from a
# trap.
on_exit() {
    on_exit_status=$?

    if [ -n "$ZIGM_SCRATCH_VERSION" ]; then
        on_exit_version="$ZIGM_SCRATCH_VERSION"
        ZIGM_SCRATCH_VERSION=''
        reclaim_scratch "$on_exit_version"
    fi

    drop_lock

    # Kept, since a shell is free to end on the status of the handler.
    return "$on_exit_status"
}

# Installs the exit handlers. Idempotent, and called by everything that takes
# the lock or makes scratch, since the last `trap` for a condition is the only
# one a shell keeps.
arm_exit() {
    trap 'on_exit' EXIT
    trap 'exit 1' HUP INT TERM
}

# Takes the lock over the data directory, or exits when another run holds it.
# Sets ZIGM_LOCK_DIR. Requires require_dirs.
require_lock() {
    # A run that already holds the lock keeps it, rather than reporting itself
    # as the other zigm that is running.
    [ -z "$ZIGM_LOCK_DIR" ] || return 0

    require_lock_dir="${ZIGM_DATA_DIR:?}/.lock"

    mkdir -p "$ZIGM_DATA_DIR" || die "cannot create $ZIGM_DATA_DIR"

    if ! mkdir "$require_lock_dir" 2>/dev/null; then
        is_stale_lock "$require_lock_dir" || die \
            "another zigm is running, or a stale lock is left at $require_lock_dir"

        warn "reclaiming the lock at $require_lock_dir, its owner is gone"
        rm -rf -- "${require_lock_dir:?}" ||
            die "cannot remove $require_lock_dir"

        # The reclaim above races every other run reclaiming the same lock, and
        # only one of them can win the `mkdir` that follows.
        mkdir "$require_lock_dir" 2>/dev/null ||
            die "another zigm is running, its lock is at $require_lock_dir"
    fi

    ZIGM_LOCK_DIR="$require_lock_dir"

    # Armed before the pid is written, so a signal arriving in between still
    # gives the lock back.
    arm_exit

    printf '%s\n' "$$" > "$require_lock_dir/pid" ||
        warn "cannot record the owner of $require_lock_dir"

    debug "lock: $require_lock_dir"
}

# Gives the lock back, if this run holds it.
drop_lock() {
    [ -n "$ZIGM_LOCK_DIR" ] || return 0

    drop_lock_dir="$ZIGM_LOCK_DIR"
    ZIGM_LOCK_DIR=''

    rm -rf -- "${drop_lock_dir:?}" || warn "cannot remove $drop_lock_dir"
}

# ---------------------------------------------------------------------------
# Tool detection
# ---------------------------------------------------------------------------

# Prints the name of an available downloader, curl preferred.
find_downloader() {
    if have curl; then
        printf 'curl\n'
    elif have wget; then
        printf 'wget\n'
    else
        return 1
    fi
}

# Prints how to decompress xz, either 'xz' for a separate binary or 'tar' when
# tar handles it alone. A separate xz is preferred since it is unambiguous.
find_xz() {
    if have xz; then
        printf 'xz\n'
    elif have tar && tar --help 2>&1 | grep -qi -e '-J' -e 'xz'; then
        printf 'tar\n'
    else
        return 1
    fi
}

# Prints the name of an available sha256 tool.
find_sha256() {
    if have sha256sum; then
        printf 'sha256sum\n'
    elif have shasum; then
        printf 'shasum\n'
    elif have openssl; then
        printf 'openssl\n'
    elif have cksum && cksum -a sha256 </dev/null >/dev/null 2>&1; then
        printf 'cksum\n'
    else
        return 1
    fi
}

# Sets ZIGM_DOWNLOADER.
require_downloader() {
    ZIGM_DOWNLOADER=$(find_downloader) ||
        die 'no downloader found, install curl or wget'
    debug "downloader: $ZIGM_DOWNLOADER"
}

# Sets ZIGM_XZ.
require_extractor() {
    have tar || die 'no tar found, install tar'
    ZIGM_XZ=$(find_xz) ||
        die 'no xz support found, install xz or a tar built with xz support'
    debug "xz via: $ZIGM_XZ"
}

# Sets ZIGM_SHA256, empty when nothing is available. Missing checksum tools are
# a loud warning rather than an error, by design.
require_sha256() {
    if ZIGM_SHA256=$(find_sha256); then
        debug "sha256 via: $ZIGM_SHA256"
    else
        ZIGM_SHA256=''
        warn 'no sha256 tool found, downloads will not be verified'
        warn 'install one of sha256sum, shasum, openssl, or a cksum with -a'
    fi
}

# ---------------------------------------------------------------------------
# Download
# ---------------------------------------------------------------------------

# fetch_stdout <url>
#
# Writes the response body to stdout. Requires require_downloader.
fetch_stdout() {
    debug "fetch: $1"
    case "$ZIGM_DOWNLOADER" in
        curl) curl -fsSL -- "$1" ;;
        wget) wget -qO- -- "$1" ;;
        *) die "unknown downloader '$ZIGM_DOWNLOADER'" ;;
    esac
}

# fetch_file <url> <destination>
#
# Downloads to destination. Requires require_downloader.
fetch_file() {
    debug "fetch: $1 -> $2"
    case "$ZIGM_DOWNLOADER" in
        curl) curl -fsSL -o "$2" -- "$1" ;;
        wget) wget -qO "$2" -- "$1" ;;
        *) die "unknown downloader '$ZIGM_DOWNLOADER'" ;;
    esac
}

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# Prints the time in seconds since the epoch, and fails when `date` cannot
# produce it. A system that cannot is not an error, it only loses caching.
find_epoch() {
    find_epoch_now=$(date +%s 2>/dev/null) || return 1
    case "$find_epoch_now" in
        '' | *[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$find_epoch_now"
}

# cache_fresh <path> <ttl seconds> <now>
#
# True when the file and its stamp both exist and the stamp is less than the
# ttl old. A stamp in the future counts as stale, so a clock that jumped
# backwards cannot pin a stale file in place.
cache_fresh() {
    [ -f "$1" ] && [ -f "$1.stamp" ] || return 1

    cache_fresh_at=$(cat "$1.stamp" 2>/dev/null) || return 1
    case "$cache_fresh_at" in
        '' | *[!0-9]*) return 1 ;;
    esac
    case "$3" in
        '' | *[!0-9]*) return 1 ;;
    esac

    [ "$3" -ge "$cache_fresh_at" ] || return 1
    [ "$(($3 - cache_fresh_at))" -lt "$2" ]
}

# fetch_cached <url> <path> <ttl seconds>
#
# Downloads the url to the path unless a fresh copy is already there. The time
# of the download is recorded in a stamp file beside it. Both --refresh and a
# system without a usable `date` force the download.
fetch_cached() {
    fetch_cached_now=$(find_epoch) || fetch_cached_now=''

    if [ "$ZIGM_REFRESH" -eq 0 ] && [ -n "$fetch_cached_now" ] &&
        cache_fresh "$2" "$3" "$fetch_cached_now"; then
        debug "cached: $2"
        return 0
    fi

    fetch_cached_dir=$(parent_dir "$2")
    mkdir -p "$fetch_cached_dir" || die "cannot create $fetch_cached_dir"

    # Download beside the target and move it into place, so an interrupted
    # download cannot leave a truncated file looking like a good one.
    fetch_file "$1" "$2.part" || die "cannot download $1"
    mv -f "$2.part" "$2" || die "cannot write $2"

    if [ -n "$fetch_cached_now" ]; then
        printf '%s\n' "$fetch_cached_now" >"$2.stamp"
    else
        rm -f "$2.stamp"
    fi
}

# ---------------------------------------------------------------------------
# JSON
#
# Both endpoints answer in json, and reading it is the whole of what a json
# tool was needed for, so a small parser here replaces that dependency.
#
# `json_flatten` prints one line per scalar: the path to it in tab separated
# fields, then its value in the last field. An empty object or array prints its
# path with an empty value, so a lookup can still tell that the key is there.
# The document
#
#     {"master": {"version": "0.17.0", "x86_64-linux": {"tarball": "u"}}}
#
# therefore flattens to
#
#     master<TAB>version<TAB>0.17.0
#     master<TAB>x86_64-linux<TAB>tarball<TAB>u
#
# which grep and awk can read directly. The remaining helpers are the three
# lookups the rest of the script makes over that form.
# ---------------------------------------------------------------------------

# Reads a json document on stdin, prints its scalars flattened, and returns
# non-zero on a document it cannot read.
#
# Tokens never span lines, since json forbids a raw newline inside a string, so
# each line is tokenized on its own and the tokens are parsed as one stream.
# Only `\"`, `\\`, and `\/` are turned back into the character they stand for.
# The rest, `\n` and `\uNNNN` among them, is passed through as written: these
# documents hold urls, digests, dates, and version strings, and a value with no
# escapes in it is the whole of what the callers below ever read. That also
# keeps a tab or a newline out of a value, which the line format relies on.
json_flatten() {
    awk '
        BEGIN { SEP = "\t" }

        function unescape(s,   res, i, n, ch, nx) {
            if (index(s, "\\") == 0)
                return s
            res = ""
            i = 1
            n = length(s)
            while (i <= n) {
                ch = substr(s, i, 1)
                if (ch != "\\") {
                    res = res ch
                    i++
                    continue
                }
                nx = substr(s, i + 1, 1)
                if (nx == "\"" || nx == "\\" || nx == "/")
                    res = res nx
                else
                    res = res ch nx
                i += 2
            }
            return res
        }

        function push(kind, text) {
            nt++
            typ[nt] = kind
            tok[nt] = text
        }

        # One line of tokens, appended to the stream the END action parses.
        {
            rest = $0
            while (rest != "") {
                if (match(rest, /^[[:space:]]+/)) {
                    rest = substr(rest, RLENGTH + 1)
                    continue
                }
                # A string ends at the first quote that is not escaped, so the
                # body is any run of non quote non backslash characters and
                # backslash pairs.
                if (match(rest, /^"([^"\\]|\\.)*"/)) {
                    push("s", unescape(substr(rest, 2, RLENGTH - 2)))
                    rest = substr(rest, RLENGTH + 1)
                    continue
                }
                head = substr(rest, 1, 1)
                if (index("{}[]:,", head) > 0) {
                    push(head, head)
                    rest = substr(rest, 2)
                    continue
                }
                # A number, or one of `true`, `false`, and `null`. Whichever it
                # is, it is printed as it stands.
                if (match(rest, /^[^][{}:,[:space:]]+/)) {
                    push("l", substr(rest, 1, RLENGTH))
                    rest = substr(rest, RLENGTH + 1)
                    continue
                }
                bad = 1
                exit
            }
        }

        function emit(path, val) {
            print path SEP val
        }

        # The depth is carried alongside the path so that the members of the
        # top level object start a path rather than extending an empty one.
        function value(path, d) {
            if (typ[ti] == "{") {
                object(path, d)
                return
            }
            if (typ[ti] == "[") {
                array(path, d)
                return
            }
            if (typ[ti] == "s" || typ[ti] == "l") {
                emit(path, tok[ti])
                ti++
                return
            }
            bad = 1
        }

        function object(path, d,   key) {
            ti++
            if (typ[ti] == "}") {
                ti++
                if (d > 0)
                    emit(path, "")
                return
            }
            for (;;) {
                if (typ[ti] != "s") { bad = 1; return }
                key = tok[ti]
                ti++
                if (typ[ti] != ":") { bad = 1; return }
                ti++
                value(d == 0 ? key : path SEP key, d + 1)
                if (bad) return
                if (typ[ti] == ",") { ti++; continue }
                if (typ[ti] == "}") { ti++; return }
                bad = 1
                return
            }
        }

        function array(path, d,   i) {
            ti++
            if (typ[ti] == "]") {
                ti++
                if (d > 0)
                    emit(path, "")
                return
            }
            i = 0
            for (;;) {
                value(d == 0 ? i "" : path SEP i, d + 1)
                if (bad) return
                i++
                if (typ[ti] == ",") { ti++; continue }
                if (typ[ti] == "]") { ti++; return }
                bad = 1
                return
            }
        }

        END {
            if (bad || nt == 0)
                exit 1
            ti = 1
            value("", 0)
            # Anything left over is a second document, or a stray token after
            # the first one, and neither is something to read half of.
            if (bad || ti != nt + 1)
                exit 1
        }
    '
}

# json_has <flattened document> <key>
#
# True when the document carries the top level key, whatever it holds.
json_has() {
    printf '%s\n' "$1" | awk -F '\t' -v k="$2" '
        $1 == k { found = 1; exit }
        END { exit(found ? 0 : 1) }
    '
}

# json_field <flattened document> <key>
#
# Prints the value of a top level scalar. A key that is missing, holds a
# container, or holds an empty string all count as absent, since a caller here
# has nothing to do with any of the three.
json_field() {
    printf '%s\n' "$1" | awk -F '\t' -v k="$2" '
        NF == 2 && $1 == k && $2 != "" { print $2; found = 1; exit }
        END { exit(found ? 0 : 1) }
    '
}

# json_subfield <flattened document> <key> <field>
#
# The same, one level down.
json_subfield() {
    printf '%s\n' "$1" | awk -F '\t' -v k="$2" -v f="$3" '
        NF == 3 && $1 == k && $2 == f && $3 != "" { print $3; found = 1; exit }
        END { exit(found ? 0 : 1) }
    '
}

# ---------------------------------------------------------------------------
# Version resolution
#
# The zig download index and the zls version API both key their per platform
# builds by `<arch>-<os>`, but the spelling of two arches changed over time:
# zig used `armv7a` up to 0.14.1 and `arm` from 0.15.1, and `i386` up to 0.10.1
# and `x86` from 0.11.0, while zls uses `armv7a` and `x86` throughout. Lookups
# therefore try a short list of candidate keys rather than one fixed key.
# ---------------------------------------------------------------------------

# target_candidates <arch> <os>
#
# Prints the keys that could name a build for this platform, best first.
target_candidates() {
    case "$1" in
        arm | armv7a) printf 'arm-%s\narmv7a-%s\n' "$2" "$2" ;;
        x86 | i386) printf 'x86-%s\ni386-%s\n' "$2" "$2" ;;
        *) printf '%s-%s\n' "$1" "$2" ;;
    esac
}

# find_target <flattened document> <arch> <os>
#
# Prints the first candidate key the document actually carries.
find_target() {
    for find_target_key in $(target_candidates "$2" "$3"); do
        if json_has "$1" "$find_target_key"; then
            printf '%s\n' "$find_target_key"
            return 0
        fi
    done
    return 1
}

# find_target_field <flattened document> <target key> <field>
#
# Prints one field of a per platform build, `tarball` or `shasum`.
find_target_field() {
    json_subfield "$1" "$2" "$3"
}

# find_release <index file> <version>
#
# Prints the index entry for a version, `master` included, flattened. The
# version itself is dropped from the front of every path, so the entry reads as
# a document of its own.
find_release() {
    [ -f "$1" ] || return 1

    find_release_flat=$(json_flatten <"$1") || return 1

    printf '%s\n' "$find_release_flat" | awk -F '\t' -v v="$2" '
        $1 == v && NF >= 2 {
            print substr($0, length($1) + 2)
            found = 1
        }
        END { exit(found ? 0 : 1) }
    '
}

# find_release_version <flattened release> <requested version>
#
# Prints the concrete version of a release. `master` always carries one, and
# tagged releases before 0.15.1 do not, but there the request is already
# concrete. A `master` entry without one is an upstream change worth failing on
# rather than storing a nightly under the name `master`.
find_release_version() {
    find_release_version_v=$(json_field "$1" version) || find_release_version_v=''

    if [ -n "$find_release_version_v" ]; then
        printf '%s\n' "$find_release_version_v"
    elif [ "$2" = master ]; then
        return 1
    else
        printf '%s\n' "$2"
    fi
}

# find_remote_versions <index file> <arch> <os>
#
# Prints the versions the index carries a build of for this platform, one per
# line, in index order. The `master` entry is printed as the concrete version it
# names today, since that is the name it would be installed under.
find_remote_versions() {
    [ -f "$1" ] || return 1

    find_remote_versions_flat=$(json_flatten <"$1") || return 1
    find_remote_versions_keys=$(target_candidates "$2" "$3")

    printf '%s\n' "$find_remote_versions_flat" |
        awk -F '\t' -v keys="$find_remote_versions_keys" '
            BEGIN { ncand = split(keys, cand, "\n") }

            # An entry is an object with contents when its paths run deeper
            # than the entry itself. The index carries nothing else at the top
            # level, and a scalar there would name no build anyway.
            {
                if (!($1 in seen)) {
                    seen[$1] = 1
                    order[++count] = $1
                }
                if (NF >= 3)
                    object[$1] = 1
                if (NF == 3 && $2 == "version" && $3 != "")
                    version[$1] = $3
                for (i = 1; i <= ncand; i++)
                    if ($2 == cand[i])
                        hit[$1] = 1
            }

            # An index carrying no build at all for this platform is a
            # failure rather than an empty list, since there is nothing the
            # caller could install from it.
            END {
                for (j = 1; j <= count; j++) {
                    key = order[j]
                    if (!(key in object) || !(key in hit))
                        continue
                    name = (key in version) ? version[key] : key
                    print name
                    found = 1
                }
                exit(found ? 0 : 1)
            }
        '
}

# normalize_query <value>
#
# Percent encodes a query string value. Of the characters a zig version can
# hold, only `+` needs it, since a server is free to read that as a space.
normalize_query() {
    printf '%s\n' "$1" | sed 's/+/%2B/g'
}

# zls_url <zig version>
#
# Prints the version selection API url for a zig version. `only-runtime` asks
# for a zls that runs against that zig, rather than one built by it.
zls_url() {
    printf '%s?zig_version=%s&compatibility=only-runtime\n' \
        "$ZIGM_ZLS_URL" "$(normalize_query "$1")"
}

# Sets ZIGM_INDEX_FILE, downloading the index when the cached copy is stale.
require_index() {
    ZIGM_INDEX_FILE="$ZIGM_CACHE_DIR/index.json"
    fetch_cached "$ZIGM_INDEX_URL" "$ZIGM_INDEX_FILE" "$ZIGM_INDEX_TTL"
}

# require_zig <version>
#
# Sets ZIGM_ZIG_VERSION, ZIGM_ZIG_TARGET, ZIGM_ZIG_TARBALL, and
# ZIGM_ZIG_SHASUM. The version may be `master`, which resolves to the concrete
# dev version the index names today. Requires require_platform.
require_zig() {
    require_index

    require_zig_flat=$(find_release "$ZIGM_INDEX_FILE" "$1") ||
        die "no zig '$1' in the download index"

    ZIGM_ZIG_VERSION=$(find_release_version "$require_zig_flat" "$1") ||
        die "the download index entry for '$1' carries no version"

    ZIGM_ZIG_TARGET=$(find_target "$require_zig_flat" "$ZIGM_ARCH" "$ZIGM_OS") ||
        die "zig $ZIGM_ZIG_VERSION has no build for $ZIGM_ARCH-$ZIGM_OS"

    ZIGM_ZIG_TARBALL=$(find_target_field "$require_zig_flat" \
        "$ZIGM_ZIG_TARGET" tarball) ||
        die "zig $ZIGM_ZIG_VERSION has no tarball for $ZIGM_ZIG_TARGET"

    # An entry without one is rare but real, and checksum verification is a
    # warning rather than an error, so an empty shasum is not fatal here.
    ZIGM_ZIG_SHASUM=$(find_target_field "$require_zig_flat" \
        "$ZIGM_ZIG_TARGET" shasum) || ZIGM_ZIG_SHASUM=''

    debug "zig $ZIGM_ZIG_VERSION ($ZIGM_ZIG_TARGET): $ZIGM_ZIG_TARBALL"
}

# require_zls <zig version>
#
# Sets ZIGM_ZLS_VERSION, ZIGM_ZLS_TARGET, ZIGM_ZLS_TARBALL, and
# ZIGM_ZLS_SHASUM. The API pairs zig and zls for tagged and master builds
# alike, so a concrete zig version is the only input it needs. The response is
# not cached, since a pairing is cheap to fetch and expensive to get wrong.
# Requires require_platform and require_downloader.
require_zls() {
    require_zls_json=$(fetch_stdout "$(zls_url "$1")") ||
        die "cannot reach the zls version API"

    require_zls_flat=$(printf '%s\n' "$require_zls_json" | json_flatten) ||
        die "cannot read the reply from the zls version API"

    # The API reports a missing or unreleased pairing as a json error object
    # rather than as an http status.
    require_zls_msg=$(json_field "$require_zls_flat" message) ||
        require_zls_msg=''
    [ -z "$require_zls_msg" ] || die "no zls for zig $1: $require_zls_msg"

    ZIGM_ZLS_VERSION=$(json_field "$require_zls_flat" version) ||
        die "the zls version API named no version for zig $1"

    ZIGM_ZLS_TARGET=$(find_target "$require_zls_flat" "$ZIGM_ARCH" "$ZIGM_OS") ||
        die "zls $ZIGM_ZLS_VERSION has no build for $ZIGM_ARCH-$ZIGM_OS"

    ZIGM_ZLS_TARBALL=$(find_target_field "$require_zls_flat" \
        "$ZIGM_ZLS_TARGET" tarball) ||
        die "zls $ZIGM_ZLS_VERSION has no tarball for $ZIGM_ZLS_TARGET"

    ZIGM_ZLS_SHASUM=$(find_target_field "$require_zls_flat" \
        "$ZIGM_ZLS_TARGET" shasum) || ZIGM_ZLS_SHASUM=''

    debug "zls $ZIGM_ZLS_VERSION ($ZIGM_ZLS_TARGET): $ZIGM_ZLS_TARBALL"
}

# ---------------------------------------------------------------------------
# Installed versions
#
# A version lives in `<data>/zigm/versions/<version>/`, which holds the zig and
# zls binaries next to zig's `lib` directory, since zig finds that directory
# relative to its own path. The active version is named by the `current`
# symlink beside `versions`, which is what the user puts on PATH.
# ---------------------------------------------------------------------------

# is_version_name <name>
#
# True when a name can name a directory under the versions directory. Anything
# holding a slash, or starting with a dot, could reach outside it or collide
# with the dot prefixed scratch directories an install writes.
is_version_name() {
    case "$1" in
        '' | .* | */*) return 1 ;;
    esac
}

# find_versions <versions dir>
#
# Prints the installed versions, one per line, in whatever order the directory
# gives. Dot prefixed entries are skipped, so a half finished install is not
# reported as a version.
find_versions() {
    [ -d "$1" ] || return 1

    for find_versions_path in "$1"/*; do
        [ -d "$find_versions_path" ] || continue
        printf '%s\n' "${find_versions_path##*/}"
    done
}

# sort_versions
#
# Reads versions on stdin and prints them oldest first. The key is the three
# numeric components, then a marker placing a `-dev` build before the release
# it leads up to, then the dev counter. Padding every number to a fixed width
# keeps the comparison a plain string sort.
sort_versions() {
    awk -F'[.]' '{
        patch = $3
        sub(/-.*$/, "", patch)
        if ($0 ~ /-dev[.]/) { tag = 0; counter = $4 + 0 }
        else { tag = 1; counter = 0 }
        printf "%08d.%08d.%08d.%d.%08d\t%s\n", $1, $2, patch, tag, counter, $0
    }' | LC_ALL=C sort | cut -f2
}

# find_meta <version dir> <key>
#
# Prints what an install recorded under a key, and fails when the record or the
# key is missing. The record is a dot prefixed `.zigm` inside the version
# directory, so it cannot collide with the tarball's own contents and every
# rename that moves the version moves it too.
find_meta() {
    [ -f "$1/.zigm" ] || return 1

    find_meta_value=$(awk -v key="$2" '
        index($0, key "=") == 1 {
            sub(/^[^=]*=/, "")
            print
            exit
        }' "$1/.zigm") || return 1

    [ -n "$find_meta_value" ] || return 1
    printf '%s\n' "$find_meta_value"
}

# write_meta <version dir> <zls version>
#
# Records what an install holds, as `key=value` lines. Nothing in either tarball
# names the zls version, so it is only knowable from here on.
write_meta() {
    printf 'zls=%s\n' "$2" >"$1/.zigm"
}

# find_zls_note <version dir>
#
# Prints the zls column `list` and `current` show for an installed version: the
# recorded version, `(unknown)` for one installed before zigm kept a record, and
# `no zls` for a directory holding no zls at all.
find_zls_note() {
    if [ ! -x "$1/zls" ]; then
        printf 'no zls\n'
    elif find_zls_note_version=$(find_meta "$1" zls); then
        printf 'zls %s\n' "$find_zls_note_version"
    else
        printf 'zls (unknown)\n'
    fi
}

# find_link_version <link path>
#
# Prints the version a `current` style symlink points at, and fails when the
# link is missing or dangling. `cd -P` resolves it without `readlink`, which is
# not in every base system.
find_link_version() {
    [ -L "$1" ] || return 1

    find_link_version_dir=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) ||
        return 1

    # The last component of the resolved path is the version, since that is
    # how installs are named. Stripping it here keeps `basename` out of the
    # way, whose handling of a leading `--` is not the same everywhere.
    find_link_version_dir="${find_link_version_dir##*/}"
    [ -n "$find_link_version_dir" ] || return 1

    printf '%s\n' "$find_link_version_dir"
}

# swap_link <target dir> <link path>
#
# Points the link at the target, replacing whatever is there already.
#
# `mv` onto a symlink to a directory moves the source inside that directory
# unless it is told not to, and the option saying so is spelled `-T` by GNU and
# `-h` by BSD, so both are tried before falling back to an unlink and a rename.
# The fallback is not atomic, but its window is one syscall wide and it leaves
# the link missing rather than wrong.
swap_link() {
    swap_link_target=$(CDPATH='' cd -P -- "$1" 2>/dev/null && pwd -P) ||
        return 1

    swap_link_tmp="$2.new"
    rm -f -- "$swap_link_tmp" || return 1
    ln -s -- "$1" "$swap_link_tmp" || return 1

    mv -T -- "$swap_link_tmp" "$2" 2>/dev/null ||
        mv -h -- "$swap_link_tmp" "$2" 2>/dev/null ||
        { rm -f -- "$2" && mv -f -- "$swap_link_tmp" "$2"; } || return 1

    # An `mv` that took neither option would have moved the new link inside the
    # old target instead of replacing it, so confirm where the link points now.
    swap_link_now=$(CDPATH='' cd -P -- "$2" 2>/dev/null && pwd -P) || return 1
    [ "$swap_link_now" = "$swap_link_target" ]
}

# ---------------------------------------------------------------------------
# Install
#
# An install is assembled in a dot prefixed scratch directory beside the
# versions, then moved into place with a rename, so a version directory is
# never half written. `list` skips dot prefixed entries, so an interrupted
# install is invisible until the next one clears it away.
# ---------------------------------------------------------------------------

# find_checksum <tool> <file>
#
# Prints the sha256 of a file as lowercase hex. The tools disagree on where the
# digest sits in their output, GNU `cksum` printing it first and BSD `cksum`
# last, so it is picked out by its shape rather than by its position.
find_checksum() {
    case "$1" in
        sha256sum) find_checksum_out=$(sha256sum "$2") ;;
        shasum) find_checksum_out=$(shasum -a 256 "$2") ;;
        openssl) find_checksum_out=$(openssl dgst -sha256 "$2") ;;
        cksum) find_checksum_out=$(cksum -a sha256 "$2") ;;
        *) return 1 ;;
    esac || return 1

    find_checksum_out=$(printf '%s\n' "$find_checksum_out" | awk '{
        for (i = 1; i <= NF; i++) {
            if (length($i) == 64 && $i ~ /^[0-9a-fA-F]+$/) {
                print tolower($i)
                exit
            }
        }
    }')

    [ -n "$find_checksum_out" ] || return 1
    printf '%s\n' "$find_checksum_out"
}

# verify_download <file> <expected shasum> <label>
#
# Checks a downloaded file against the shasum upstream published for it. A
# mismatch is fatal, while having nothing to compare against, either because no
# tool was found or because the index carries no shasum, is only a warning.
# Requires require_sha256.
verify_download() {
    [ -n "$ZIGM_SHA256" ] || return 0

    if [ -z "$2" ]; then
        warn "$3 has no published checksum, it was not verified"
        return 0
    fi

    verify_download_got=$(find_checksum "$ZIGM_SHA256" "$1") || {
        warn "cannot checksum $3 with $ZIGM_SHA256, it was not verified"
        return 0
    }

    verify_download_want=$(printf '%s\n' "$2" | tr '[:upper:]' '[:lower:]')
    [ "$verify_download_got" = "$verify_download_want" ] ||
        die "checksum mismatch for $3, expected $verify_download_want, got $verify_download_got"

    debug "checksum ok: $3"
}

# unpack_tarball <tarball> <destination directory>
#
# Requires require_extractor. When xz is a separate binary the pipe hides its
# exit status, which the caller catches by checking the payload afterwards.
unpack_tarball() {
    case "$ZIGM_XZ" in
        xz) xz -dc <"$1" | tar -xf - -C "$2" ;;
        tar) tar -xJf "$1" -C "$2" ;;
        *) return 1 ;;
    esac
}

# find_extract_root <directory>
#
# Prints the directory holding the unpacked files. A zig tarball unpacks into a
# single directory named after the release, while a zls tarball unpacks its
# files directly, so the one is stripped and the other is not.
find_extract_root() {
    [ -d "$1" ] || return 1

    find_extract_root_only=''
    for find_extract_root_path in "$1"/*; do
        # An unmatched glob expands to itself, which names nothing.
        [ -e "$find_extract_root_path" ] || return 1

        if [ -n "$find_extract_root_only" ]; then
            printf '%s\n' "$1"
            return 0
        fi
        find_extract_root_only="$find_extract_root_path"
    done

    if [ -d "$find_extract_root_only" ]; then
        printf '%s\n' "$find_extract_root_only"
    else
        printf '%s\n' "$1"
    fi
}

# move_contents <source directory> <destination directory>
#
# Moves everything in the source into the destination, replacing entries of the
# same name.
move_contents() {
    [ -d "$1" ] && [ -d "$2" ] || return 1

    for move_contents_path in "$1"/*; do
        [ -e "$move_contents_path" ] || return 1

        # The destination is checked rather than trusted, since an empty one
        # would turn the removal below into an `rm -rf /`.
        move_contents_name="${move_contents_path##*/}"
        rm -rf -- "${2:?}/$move_contents_name" || return 1
        mv -f -- "$move_contents_path" "$2/$move_contents_name" || return 1
    done
}

# install_tarball <name> <version> <url> <shasum> <scratch> <root> <take>
#
# Downloads, verifies, and unpacks one tarball into the root being assembled.
# The download lands in the scratch directory rather than in the cache, since
# it is removed as soon as it is unpacked and the scratch directory is the one
# place an interrupted install leaves nothing behind.
#
# `take` is `all` for the whole payload, or the name of the one file to take.
# zig is unpacked whole, since it owns the layout of a version directory, and
# zls contributes its binary alone, so that its README and its LICENSE cannot
# land on zig's.
install_tarball() {
    install_tarball_file="$5/$1.tar.xz"
    install_tarball_out="$5/$1"

    info "downloading $1 $2"
    fetch_file "$3" "$install_tarball_file" || die "cannot download $3"
    verify_download "$install_tarball_file" "$4" "$1 $2"

    mkdir -p "$install_tarball_out" || die "cannot create $install_tarball_out"
    unpack_tarball "$install_tarball_file" "$install_tarball_out" ||
        die "cannot unpack the $1 tarball"
    rm -f -- "$install_tarball_file"

    install_tarball_from=$(find_extract_root "$install_tarball_out") ||
        die "the $1 tarball unpacked to nothing"

    if [ "$7" = all ]; then
        move_contents "$install_tarball_from" "$6" ||
            die "cannot assemble the $1 $2 install"
    else
        [ -f "$install_tarball_from/$7" ] ||
            die "the $1 tarball held no $7"
        mv -f -- "$install_tarball_from/$7" "$6/$7" ||
            die "cannot assemble the $1 $2 install"
    fi
}

# reclaim_scratch <version>
#
# Clears the `.new-` and `.old-` directories an install of that version works
# in, putting the old install back when the new one never arrived. Between the
# two renames install_payload makes, the old version is reachable only through
# `.old-`, so that one is restored rather than removed.
#
# It reports rather than dies, since it also runs from a trap with the script
# already on its way out.
reclaim_scratch() {
    # Both parts are refused when empty, so the paths below, which are removed
    # recursively, cannot collapse towards the root.
    reclaim_scratch_dir="${ZIGM_VERSIONS_DIR:?}/${1:?}"
    reclaim_scratch_new="$ZIGM_VERSIONS_DIR/.new-$1"
    reclaim_scratch_old="$ZIGM_VERSIONS_DIR/.old-$1"

    if [ -e "$reclaim_scratch_new" ]; then
        rm -rf -- "$reclaim_scratch_new" ||
            warn "cannot remove $reclaim_scratch_new"
    fi

    [ -e "$reclaim_scratch_old" ] || return 0

    if [ -e "$reclaim_scratch_dir" ]; then
        rm -rf -- "$reclaim_scratch_old" ||
            warn "cannot remove $reclaim_scratch_old"
    elif mv -f -- "$reclaim_scratch_old" "$reclaim_scratch_dir"; then
        warn "put zig $1 back, its reinstall did not finish"
    else
        warn "cannot put zig $1 back at $reclaim_scratch_dir"
    fi
}

# sweep_scratch
#
# Reclaims every scratch pair under the versions directory. An install traps
# the signals it can and clears its own, so what is left here comes from one
# killed outright, or from a crash or a power loss.
sweep_scratch() {
    [ -d "${ZIGM_VERSIONS_DIR:-}" ] || return 0

    for sweep_scratch_entry in "$ZIGM_VERSIONS_DIR"/.new-* \
        "$ZIGM_VERSIONS_DIR"/.old-*; do
        # A pattern matching nothing is left as it is written, and a pair is
        # cleared by whichever half is reached first, so the rest are skipped.
        [ -d "$sweep_scratch_entry" ] || continue

        sweep_scratch_name=${sweep_scratch_entry##*/}
        sweep_scratch_version=${sweep_scratch_name#.new-}
        sweep_scratch_version=${sweep_scratch_version#.old-}
        [ -n "$sweep_scratch_version" ] || continue

        reclaim_scratch "$sweep_scratch_version"
        info "cleared the unfinished install of zig $sweep_scratch_version"
    done
}

# install_payload <version directory>
#
# Assembles a version directory from the resolved tarballs and moves it into
# place. Requires require_zig, and require_zls unless ZIGM_NO_ZLS is set.
install_payload() {
    install_payload_dir="$1"

    # The names match the ones reclaim_scratch builds, which is what lets a
    # later run tidy up after this one.
    install_payload_scratch="${ZIGM_VERSIONS_DIR:?}/.new-${ZIGM_ZIG_VERSION:?}"
    install_payload_old="$ZIGM_VERSIONS_DIR/.old-$ZIGM_ZIG_VERSION"
    install_payload_root="$install_payload_scratch/root"

    # Every exit from here on goes through reclaim_scratch, including the one
    # an interrupt makes, which is what the exit handler is for.
    ZIGM_SCRATCH_VERSION="$ZIGM_ZIG_VERSION"
    arm_exit

    rm -rf -- "$install_payload_scratch" ||
        die "cannot clear $install_payload_scratch"
    mkdir -p "$install_payload_root" ||
        die "cannot create $install_payload_root"

    install_tarball zig "$ZIGM_ZIG_VERSION" "$ZIGM_ZIG_TARBALL" \
        "$ZIGM_ZIG_SHASUM" "$install_payload_scratch" \
        "$install_payload_root" all
    [ -x "$install_payload_root/zig" ] ||
        die 'the zig tarball held no zig binary'

    if [ -n "$ZIGM_ZLS_VERSION" ]; then
        install_tarball zls "$ZIGM_ZLS_VERSION" "$ZIGM_ZLS_TARBALL" \
            "$ZIGM_ZLS_SHASUM" "$install_payload_scratch" \
            "$install_payload_root" zls
        [ -x "$install_payload_root/zls" ] ||
            die 'the zls binary is not executable'
    fi

    # The record is written into the scratch root, so it arrives with the rest
    # of the install rather than in a step of its own. Failing to write it costs
    # the zls column and nothing else, so it is not worth losing the install to.
    write_meta "$install_payload_root" "$ZIGM_ZLS_VERSION" ||
        warn "cannot record what zig $ZIGM_ZIG_VERSION holds"

    # A reinstall moves the old directory aside rather than deleting it, so the
    # version is missing for one rename instead of for the whole swap.
    rm -rf -- "$install_payload_old" || die "cannot clear $install_payload_old"
    if [ -d "$install_payload_dir" ]; then
        mv -f -- "$install_payload_dir" "$install_payload_old" ||
            die "cannot replace $install_payload_dir"
    fi

    # A failure here leaves the old version in `.old-` alone, which is where
    # reclaim_scratch finds it and puts it back.
    mv -f -- "$install_payload_root" "$install_payload_dir" ||
        die "cannot move the install into $install_payload_dir"

    ZIGM_SCRATCH_VERSION=''
    reclaim_scratch "$ZIGM_ZIG_VERSION"
}

# install_zls_into <version directory>
#
# Adds a zls to a version that is already installed, which is how an install
# made with `--no-zls` gains one later. Requires require_zls.
#
# The rest of the directory is left alone, so this is not a reinstall: the
# binary is unpacked in the same scratch directory an install works in and then
# moved in on its own, and a failure anywhere leaves the version as it was.
install_zls_into() {
    install_zls_into_dir="$1"
    install_zls_into_scratch="${ZIGM_VERSIONS_DIR:?}/.new-${ZIGM_ZIG_VERSION:?}"
    install_zls_into_root="$install_zls_into_scratch/root"

    ZIGM_SCRATCH_VERSION="$ZIGM_ZIG_VERSION"
    arm_exit

    rm -rf -- "$install_zls_into_scratch" ||
        die "cannot clear $install_zls_into_scratch"
    mkdir -p "$install_zls_into_root" ||
        die "cannot create $install_zls_into_root"

    install_tarball zls "$ZIGM_ZLS_VERSION" "$ZIGM_ZLS_TARBALL" \
        "$ZIGM_ZLS_SHASUM" "$install_zls_into_scratch" \
        "$install_zls_into_root" zls
    [ -x "$install_zls_into_root/zls" ] ||
        die 'the zls binary is not executable'

    mv -f -- "$install_zls_into_root/zls" "$install_zls_into_dir/zls" ||
        die "cannot move zls into $install_zls_into_dir"

    write_meta "$install_zls_into_dir" "$ZIGM_ZLS_VERSION" ||
        warn "cannot record what zig $ZIGM_ZIG_VERSION holds"

    ZIGM_SCRATCH_VERSION=''
    reclaim_scratch "$ZIGM_ZIG_VERSION"
}

# install_version <requested version> <activate, 0 or 1>
#
# Resolves a version, installs it unless it is already there, and points
# `current` at it when asked. Reads ZIGM_NO_ZLS and ZIGM_FORCE.
install_version() {
    require_zig "$1"

    install_version_dir="$ZIGM_VERSIONS_DIR/$ZIGM_ZIG_VERSION"

    if [ -d "$install_version_dir" ] && [ "$ZIGM_FORCE" -eq 0 ]; then
        # The pairing is left unasked for, since a version that is already
        # there is not about to be assembled again, and a pairing that has
        # since disappeared would fail an install with nothing left to do. The
        # exception is a version holding no zls, which is what an install made
        # with `--no-zls` leaves and what this fills in.
        info "zig $ZIGM_ZIG_VERSION is already installed"

        if [ "$ZIGM_NO_ZLS" -eq 0 ] && [ ! -x "$install_version_dir/zls" ]; then
            require_zls "$ZIGM_ZIG_VERSION"
            install_zls_into "$install_version_dir"
            info "added zls $ZIGM_ZLS_VERSION to zig $ZIGM_ZIG_VERSION"
        fi
    else
        if [ "$ZIGM_NO_ZLS" -eq 1 ]; then
            # Nothing is asked of the version selection API, since the answer
            # would only be thrown away.
            ZIGM_ZLS_VERSION=''
            warn "zls was skipped, installing zig $ZIGM_ZIG_VERSION alone"
        else
            require_zls "$ZIGM_ZIG_VERSION"
        fi

        install_payload "$install_version_dir"
        if [ -n "$ZIGM_ZLS_VERSION" ]; then
            info "installed zig $ZIGM_ZIG_VERSION with zls $ZIGM_ZLS_VERSION"
        else
            info "installed zig $ZIGM_ZIG_VERSION"
        fi
    fi

    [ "$2" -eq 1 ] || return 0

    swap_link "$install_version_dir" "$ZIGM_CURRENT_LINK" ||
        die "cannot point $ZIGM_CURRENT_LINK at $install_version_dir"
    info "now using zig $ZIGM_ZIG_VERSION"
}

# ---------------------------------------------------------------------------
# Commands
#
# Each command declares the tools it needs, so a missing dependency fails
# before any work happens.
# ---------------------------------------------------------------------------

cmd_install() {
    ZIGM_NO_ZLS=0
    ZIGM_FORCE=0
    cmd_install_use=1
    cmd_install_version=''

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-zls) ZIGM_NO_ZLS=1 ;;
            --no-use) cmd_install_use=0 ;;
            --force) ZIGM_FORCE=1 ;;
            -*) die_usage "unknown option '$1' for install" ;;
            *)
                [ -z "$cmd_install_version" ] ||
                    die_usage 'install takes exactly one version'
                cmd_install_version="$1"
                ;;
        esac
        shift
    done

    [ -n "$cmd_install_version" ] || die_usage 'install takes exactly one version'
    is_version_name "$cmd_install_version" ||
        die_usage "'$cmd_install_version' is not a version"

    require_downloader
    require_extractor
    require_sha256
    ensure_dirs
    require_lock

    install_version "$cmd_install_version" "$cmd_install_use"
}

cmd_use() {
    [ "$#" -eq 1 ] || die_usage 'use takes exactly one version'
    is_version_name "$1" || die_usage "'$1' is not a version"
    ensure_dirs
    require_lock

    cmd_use_dir="$ZIGM_VERSIONS_DIR/$1"
    if [ ! -d "$cmd_use_dir" ]; then
        # master is stored under the dev version it resolved to, so it never
        # names a directory of its own.
        [ "$1" != master ] ||
            die "master is installed under its resolved version, see 'zigm list'"
        die "zig $1 is not installed, run 'zigm install $1'"
    fi

    swap_link "$cmd_use_dir" "$ZIGM_CURRENT_LINK" ||
        die "cannot point $ZIGM_CURRENT_LINK at $cmd_use_dir"

    info "now using zig $1"
}

cmd_uninstall() {
    [ "$#" -eq 1 ] || die_usage 'uninstall takes exactly one version'
    is_version_name "$1" || die_usage "'$1' is not a version"

    # Taken before the version is looked for, so no install can arrive between
    # the look and the removal.
    require_lock

    # is_version_name has already refused an empty name and a name holding a
    # slash or a dot, so a non-empty versions directory keeps the removal below
    # away from the root.
    cmd_uninstall_dir="${ZIGM_VERSIONS_DIR:?}/$1"
    [ -d "$cmd_uninstall_dir" ] || die "zig $1 is not installed"

    # Drop the link first, so an interrupted removal cannot leave `current`
    # pointing into a half deleted directory.
    if [ "$(find_link_version "$ZIGM_CURRENT_LINK")" = "$1" ]; then
        rm -f -- "$ZIGM_CURRENT_LINK" ||
            die "cannot remove $ZIGM_CURRENT_LINK"
        warn "zig $1 was active, no version is active now"
    fi

    rm -rf -- "$cmd_uninstall_dir" || die "cannot remove $cmd_uninstall_dir"
    info "removed zig $1"
}

cmd_list() {
    [ "$#" -eq 0 ] || die_usage 'list takes no arguments'

    cmd_list_active=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        cmd_list_active=''
    cmd_list_all=$(find_versions "$ZIGM_VERSIONS_DIR" | sort_versions)

    if [ -z "$cmd_list_all" ]; then
        note 'no versions installed'
        return 0
    fi

    # The active version is marked with a star, and the zls each version holds
    # is named in a column of its own, so a caller that wants bare names can
    # take the first field of a line with its first two columns cut.
    printf '%s\n' "$cmd_list_all" | while IFS= read -r cmd_list_version; do
        if [ "$cmd_list_version" = "$cmd_list_active" ]; then
            cmd_list_mark='*'
        else
            cmd_list_mark=' '
        fi

        printf '%s %-26s  %s\n' "$cmd_list_mark" "$cmd_list_version" \
            "$(find_zls_note "$ZIGM_VERSIONS_DIR/$cmd_list_version")"
    done
}

cmd_list_remote() {
    [ "$#" -eq 0 ] || die_usage 'list-remote takes no arguments'
    require_downloader
    require_index

    # The nightly is listed under the version it resolves to today, so it needs
    # naming separately for the annotation. An index without a usable master
    # entry is not fatal here, it only costs the annotation.
    cmd_list_remote_master=''
    if cmd_list_remote_json=$(find_release "$ZIGM_INDEX_FILE" master); then
        cmd_list_remote_master=$(find_release_version \
            "$cmd_list_remote_json" master) || cmd_list_remote_master=''
    fi

    cmd_list_remote_all=$(find_remote_versions "$ZIGM_INDEX_FILE" \
        "$ZIGM_ARCH" "$ZIGM_OS" | sort_versions)
    [ -n "$cmd_list_remote_all" ] ||
        die "the download index has no build for $ZIGM_ARCH-$ZIGM_OS"

    cmd_list_remote_active=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        cmd_list_remote_active=''

    # The order and the marks match `list`: a star on the active version, and
    # here an `i` on one that is installed but not active.
    printf '%s\n' "$cmd_list_remote_all" | while IFS= read -r cmd_list_remote_v; do
        if [ "$cmd_list_remote_v" = "$cmd_list_remote_active" ]; then
            cmd_list_remote_mark='*'
        elif [ -d "$ZIGM_VERSIONS_DIR/$cmd_list_remote_v" ]; then
            cmd_list_remote_mark='i'
        else
            cmd_list_remote_mark=' '
        fi

        if [ "$cmd_list_remote_v" = "$cmd_list_remote_master" ]; then
            printf '%s %s (master)\n' "$cmd_list_remote_mark" "$cmd_list_remote_v"
        else
            printf '%s %s\n' "$cmd_list_remote_mark" "$cmd_list_remote_v"
        fi
    done
}

cmd_which() {
    [ "$#" -le 1 ] || die_usage 'which takes at most one binary name'
    cmd_which_name=${1:-zig}
    case "$cmd_which_name" in
        '' | */*) die_usage "'$cmd_which_name' is not a binary name" ;;
    esac

    cmd_which_version=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        die "no version is active, run 'zigm use <version>'"

    # The resolved path is printed rather than the one through `current`, since
    # it names the version the binary belongs to.
    cmd_which_path="$ZIGM_VERSIONS_DIR/$cmd_which_version/$cmd_which_name"
    [ -x "$cmd_which_path" ] ||
        die "zig $cmd_which_version has no '$cmd_which_name'"

    printf '%s\n' "$cmd_which_path"
}

cmd_current() {
    [ "$#" -eq 0 ] || die_usage 'current takes no arguments'

    cmd_current_version=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        die "no version is active, run 'zigm use <version>'"

    # The columns line up with `list`, whose mark and version take the same
    # width, so the two read as one table.
    printf '%-28s  %s\n' "$cmd_current_version" \
        "$(find_zls_note "$ZIGM_VERSIONS_DIR/$cmd_current_version")"
}

# normalize_env <the output of `zig env`>
#
# Prints that output as json, whichever of the two shapes zig wrote it in: json
# up to 0.14, and zon from 0.15 on. A json document is passed through and a zon
# one is converted, so a caller reads one format across every version.
#
# The zon zig writes here is a struct of strings, nulls, and nested structs,
# one field to a line, so a line at a time is enough and no zon parser is
# needed. A line of any other shape fails rather than being guessed at.
#
# An escape zig has and json does not, `\xNN` for a byte json spells `\u00NN`,
# is passed through as it stands. The values here are paths and version
# strings, so one would take a path holding a control character.
normalize_env() {
    normalize_env_head=$(printf '%s\n' "$1" |
        sed -n '/[^[:space:]]/{s/^[[:space:]]*//;p;q;}')

    case "$normalize_env_head" in
        '{'*)
            printf '%s\n' "$1"
            return 0
            ;;
        '.{'*) ;;
        *) return 1 ;;
    esac

    printf '%s\n' "$1" | awk '
        # Holds one line back, since whether it takes a comma depends on the
        # line after it: json puts none on the last member of an object.
        function emit(text, kind,   sep) {
            if (held != "") {
                sep = (held_kind == "open" || kind == "close") ? "" : ","
                print held sep
            }
            held = text
            held_kind = kind
        }

        function indent(   pad, i) {
            pad = ""
            for (i = 0; i < depth; i++)
                pad = pad "  "
            return pad
        }

        {
            line = $0
            sub(/^[[:space:]]+/, "", line)
            sub(/[[:space:]]+$/, "", line)
            if (line == "")
                next

            if (line == ".{") {
                emit(indent() "{", "open")
                depth++
                next
            }

            if (line == "}" || line == "},") {
                depth--
                if (depth < 0) {
                    bad = 1
                    exit
                }
                emit(indent() "}", "close")
                next
            }

            if (match(line, /^\.[A-Za-z_][A-Za-z0-9_]*/) != 1) {
                bad = 1
                exit
            }
            key = substr(line, 2, RLENGTH - 1)
            value = substr(line, RLENGTH + 1)
            sub(/^[[:space:]]*=[[:space:]]*/, "", value)
            sub(/,$/, "", value)

            if (value == ".{") {
                emit(indent() "\"" key "\": {", "open")
                depth++
                next
            }

            # An enum literal is a bare name in zon and a string in json. Zig
            # writes none of them here today, and this keeps one out of the
            # output as something json cannot read if it ever does.
            if (value ~ /^\.[A-Za-z_][A-Za-z0-9_]*$/)
                value = "\"" substr(value, 2) "\""

            emit(indent() "\"" key "\": " value, "leaf")
        }

        END {
            # A document that ended mid struct is as much a failure as a line
            # that could not be read, since half of it would still be printed.
            if (bad || depth != 0 || held == "")
                exit 1
            print held
        }
    '
}

cmd_env() {
    [ "$#" -eq 0 ] || die_usage 'env takes no arguments'

    cmd_env_version=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        die "no version is active, run 'zigm use <version>'"

    cmd_env_zig="$ZIGM_VERSIONS_DIR/$cmd_env_version/zig"
    [ -x "$cmd_env_zig" ] || die "zig $cmd_env_version has no 'zig'"

    cmd_env_out=$("$cmd_env_zig" env) ||
        die "'zig env' failed for zig $cmd_env_version"

    normalize_env "$cmd_env_out" ||
        die "cannot read the output of 'zig env' for zig $cmd_env_version"
}

cmd_update() {
    ZIGM_NO_ZLS=0
    ZIGM_FORCE=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-zls) ZIGM_NO_ZLS=1 ;;
            --force) ZIGM_FORCE=1 ;;
            -*) die_usage "unknown option '$1' for update" ;;
            *) die_usage 'update takes no arguments, it always installs master' ;;
        esac
        shift
    done

    require_downloader
    require_extractor
    require_sha256
    ensure_dirs
    require_lock

    # A nightly is what update replaces, so `current` follows the new one only
    # when it pointed at a nightly already, or when nothing is active at all
    # and no choice of the user's can be disturbed.
    cmd_update_active=$(find_link_version "$ZIGM_CURRENT_LINK") ||
        cmd_update_active=''
    case "$cmd_update_active" in
        '' | *-dev.*) cmd_update_use=1 ;;
        *) cmd_update_use=0 ;;
    esac

    # update is an install of whatever master points at today, so it always
    # refetches the index rather than trusting a cached one.
    ZIGM_REFRESH=1
    install_version master "$cmd_update_use"
}

cmd_clean() {
    [ "$#" -eq 0 ] || die_usage 'clean takes no arguments'

    # Held for the sweep below, which would otherwise take the scratch of a
    # running install for the leavings of a dead one.
    require_lock

    # First, since the cache being empty already is enough to end the command.
    sweep_scratch

    # The cache holds only the download index and the tarballs, both of which
    # are refetched on demand, so the whole directory goes.
    [ -n "$ZIGM_CACHE_DIR" ] || die 'the cache directory is empty'
    if [ ! -d "$ZIGM_CACHE_DIR" ]; then
        note 'the cache is already empty'
        return 0
    fi

    # This is the one directory a user hands to a recursive removal, so a
    # ZIGM_CACHE_DIR of `/` is refused rather than obeyed.
    is_removable "$ZIGM_CACHE_DIR" ||
        die "refusing to remove $ZIGM_CACHE_DIR"

    rm -rf -- "$ZIGM_CACHE_DIR" || die "cannot remove $ZIGM_CACHE_DIR"
    info "removed $ZIGM_CACHE_DIR"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

# main <arguments>
#
# The global options are taken wherever they appear, so `zigm install -v 0.15.1`
# reads the same as `zigm -v install 0.15.1`. The command and everything the
# command owns are collected as they are found: each argument is shifted off the
# front and either consumed or appended to the end, and the counter of arguments
# still to look at keeps the appended ones from being read a second time. An
# argument list is the only list POSIX sh has.
main() {
    main_cmd=''
    main_help=0
    main_end=0
    main_left="$#"

    while [ "$main_left" -gt 0 ]; do
        main_arg="$1"
        shift
        main_left=$((main_left - 1))

        # Past a `--` nothing is an option any more, so the rest is the command
        # and its arguments however they are spelled.
        if [ "$main_end" -eq 1 ]; then
            if [ -z "$main_cmd" ]; then
                main_cmd="$main_arg"
            else
                set -- "$@" "$main_arg"
            fi
            continue
        fi

        case "$main_arg" in
            # Held rather than acted on, since which help to print depends on
            # whether a command turns up later on the line.
            -h | --help) main_help=1 ;;
            -V | --version)
                printf '%s\n' "$ZIGM_VERSION"
                return 0
                ;;
            -v | --verbose) ZIGM_VERBOSE=1 ;;
            -q | --quiet) ZIGM_QUIET=1 ;;
            --refresh) ZIGM_REFRESH=1 ;;
            --) main_end=1 ;;
            -*)
                # An option before the command can only be zigm's own, so an
                # unknown one is reported here rather than handed on.
                [ -n "$main_cmd" ] || die_usage "unknown option '$main_arg'"
                set -- "$@" "$main_arg"
                ;;
            *)
                if [ -z "$main_cmd" ]; then
                    main_cmd="$main_arg"
                else
                    set -- "$@" "$main_arg"
                fi
                ;;
        esac
    done

    if [ "$main_help" -eq 1 ]; then
        [ -n "$main_cmd" ] || {
            usage
            return 0
        }
        usage_command "$main_cmd" || die_usage "unknown command '$main_cmd'"
        return 0
    fi

    if [ -z "$main_cmd" ]; then
        usage >&2
        return "$ZIGM_EX_USAGE"
    fi

    require_platform
    require_dirs

    case "$main_cmd" in
        install) cmd_install "$@" ;;
        use) cmd_use "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        list) cmd_list "$@" ;;
        list-remote) cmd_list_remote "$@" ;;
        which) cmd_which "$@" ;;
        current) cmd_current "$@" ;;
        env) cmd_env "$@" ;;
        update) cmd_update "$@" ;;
        clean) cmd_clean "$@" ;;
        *) die_usage "unknown command '$main_cmd'" ;;
    esac
}

if [ "${ZIGM_LIB:-0}" != 1 ]; then
    main "$@"
fi
